# Copy to .env values into your shell/host environment (the app reads process.env; no dotenv needed).
PORT=3000
DB_FILE=./data/campuscare.db
UPLOAD_DIR=./data/uploads
SESSION_HOURS=8
NODE_ENV=development
# Only accept this email domain at registration (leave empty to accept any):
STUDENT_EMAIL_DOMAIN=
# If true, unverified students cannot submit complaints until an admin verifies them:
REQUIRE_VERIFICATION=false
REOPEN_WINDOW_DAYS=14
# Used only by `npm run create-admin`:
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
